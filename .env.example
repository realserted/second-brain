# Reference only: the app reads real environment variables, not this file.
# Set them in your shell, or in the MCP client config (see README). Use absolute paths there.
SECOND_BRAIN_DB=data/second_brain.db
SECOND_BRAIN_DOCS=data/docs
SECOND_BRAIN_EMBEDDER=fastembed
SECOND_BRAIN_EMBED_MODEL=BAAI/bge-small-en-v1.5
SECOND_BRAIN_CHUNK_SIZE=900
SECOND_BRAIN_CHUNK_OVERLAP=150
SECOND_BRAIN_TOP_K=5
SECOND_BRAIN_MIN_SCORE=0.56
SECOND_BRAIN_REDACT=ssn,credit_card,bank_account,routing_number

# Only needed for evals/judge.py
ANTHROPIC_API_KEY=
SECOND_BRAIN_ANSWER_MODEL=claude-sonnet-5-5
SECOND_BRAIN_JUDGE_MODEL=claude-haiku-4-5-20251001
